generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  SUSPENDED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_AGENT
}

enum ProjectStatus {
  UPCOMING
  ONGOING
  READY_TO_MOVE
}

enum PropertyType {
  APARTMENT
  VILLA
  PENTHOUSE
  COMMERCIAL
  PLOT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  LOST
}

enum VisitStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
  BROCHURE
  FLOOR_PLAN
  MASTER_PLAN
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  phone        String?
  passwordHash String
  role         Role            @default(SALES_AGENT)
  status       UserStatus      @default(ACTIVE)
  isActive     Boolean         @default(true)
  agent        Agent?
  activities   AdminActivity[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([role])
  @@index([status])
}

model Agent {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id])
  name       String
  email      String    @unique
  phone      String
  whatsapp   String?
  avatarUrl  String?
  bio        String?
  properties Property[]
  enquiries  Enquiry[]
  visits     SiteVisit[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

}

model PropertyCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Property {
  id                 String             @id @default(cuid())
  title              String
  slug               String             @unique
  description        String
  price              Decimal            @db.Decimal(14, 2)
  currency           String             @default("INR")
  address            String
  city               String
  location           String
  latitude           Decimal?           @db.Decimal(10, 7)
  longitude          Decimal?           @db.Decimal(10, 7)
  mapLink            String?
  type               PropertyType
  bedrooms           Int?
  bathrooms          Int?
  siteArea           String?
  constructionStatus String?
  builderName        String?
  status             ProjectStatus
  amenities          String[]
  nearbyLandmarks    String[]
  isFeatured         Boolean            @default(false)
  isPublished        Boolean            @default(false)
  publishedAt        DateTime?
  categoryId         String?
  category           PropertyCategory?  @relation(fields: [categoryId], references: [id])
  agentId            String?
  agent              Agent?             @relation(fields: [agentId], references: [id])
  images             PropertyImage[]
  enquiries          Enquiry[]
  siteVisits         SiteVisit[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([city, location])
  @@index([price])
  @@index([status])
  @@index([type])
  @@index([isPublished, isFeatured])
}

model PropertyImage {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  key        String
  alt        String?
  type       MediaType @default(IMAGE)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([propertyId, sortOrder])
}

model Enquiry {
  id         String     @id @default(cuid())
  name       String
  phone      String
  email      String?
  message    String?
  status     LeadStatus @default(NEW)
  propertyId String?
  property   Property?  @relation(fields: [propertyId], references: [id])
  agentId    String?
  agent      Agent?     @relation(fields: [agentId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  notes      String?

  @@index([status, createdAt])
  @@index([propertyId])
}

model SiteVisit {
  id              String      @id @default(cuid())
  name            String
  phone           String
  email           String?
  message         String?
  preferredAt     DateTime
  status          VisitStatus @default(REQUESTED)
  propertyId      String?
  property        Property?   @relation(fields: [propertyId], references: [id])
  assignedAgentId String?
  assignedAgent   Agent?      @relation(fields: [assignedAgentId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, preferredAt])
  @@index([propertyId])
}

model Blog {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverUrl    String?
  tags        String[]
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model AdminActivity {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  visitorId String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([path])
}
